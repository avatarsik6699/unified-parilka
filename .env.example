# Safe configuration template. This file contains no usable credentials.
# Copy it to a non-versioned dotenv file, replace example IDs/paths, and chmod 0600.
#
# Bootstrap-only process variables (set before Node starts, not inside the file
# they are meant to select):
#   TELEGRAM_SHARED_ENV_PATH=~/.config/telegram-mcp/.env
#   TELEGRAM_ENV_PATH=/absolute/path/to/your-checkout/.env

# Structured service logs and the fixed local MCP endpoint.
BOT_LOG_LEVEL=info
BOT_MCP_HTTP_URL=http://127.0.0.1:8766/mcp

# Telegram API credentials from https://my.telegram.org/apps.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Generate with `npm run generate-session`. This GramJS StringSession (including
# the compact Telethon-compatible form accepted by legacy GramJS) is used only
# as a bootstrap secret for mtcute and is never committed.
TELEGRAM_SESSION=

# Default transport is mtcute. Set gramjs only for an explicit rollback.
TELEGRAM_TRANSPORT=mtcute
TELEGRAM_CONNECTION_RETRIES=5
TELEGRAM_MTCUTE_AUTH_DB_PATH=~/.telegram-parilka-mcp/mtcute-auth.sqlite
TELEGRAM_MTCUTE_HISTORY_PAGE_SIZE=100
TELEGRAM_MTCUTE_MAX_HISTORY_MESSAGES=1000000
TELEGRAM_MTCUTE_CONNECTION_MAX_ATTEMPTS=5
TELEGRAM_MTCUTE_CONNECTION_TIMEOUT_MS=30000
TELEGRAM_MTCUTE_CONNECTION_RETRY_INITIAL_MS=250
TELEGRAM_MTCUTE_CONNECTION_RETRY_MAX_MS=4000
TELEGRAM_MTCUTE_REQUEST_TIMEOUT_MS=120000
TELEGRAM_MTCUTE_REQUEST_MAX_RETRIES=2
TELEGRAM_MTCUTE_REQUEST_RETRY_DELAY_MS=1000
TELEGRAM_MTCUTE_FLOOD_WAIT_MAX_MS=10000

# Replace this deliberately fake ID with the target supergroup/channel ID.
TELEGRAM_DEFAULT_CHAT_ID=-1000000000000
TELEGRAM_ALLOWED_CHAT_IDS=-1000000000000
TELEGRAM_REQUIRE_ALLOWLIST=true

# Canonical application store shared by sync, MCP, bot, and maintenance.
# It must differ from TELEGRAM_MTCUTE_AUTH_DB_PATH.
TELEGRAM_DB_PATH=~/.telegram-parilka-mcp/messages.sqlite

# MCP live-send safety. Defaults below force every MCP write into dry-run.
# approval_id is a self-issued payload capability, not human approval.
TELEGRAM_SEND_ENABLED=false
TELEGRAM_DRY_RUN_DEFAULT=true
TELEGRAM_LIVE_SEND_APPROVAL_TTL_MS=300000
TELEGRAM_LIVE_SEND_APPROVAL_BYPASS=false
TELEGRAM_MAX_SEND_CHARS=4096

# History sync and owner daemon.
TELEGRAM_HISTORY_BATCH_SIZE=100
TELEGRAM_MAX_SYNC_LIMIT=500000
TELEGRAM_FLOOD_WAIT_MAX_SLEEP_SEC=10
TELEGRAM_HISTORY_WAIT_TIME_SEC=1
TELEGRAM_HISTORY_OPERATION_TIMEOUT_MS=120000
TELEGRAM_SYNC_INTERVAL_MS=60000
TELEGRAM_SYNC_RECENT_LIMIT=300
TELEGRAM_SYNC_BACKFILL_LIMIT=1000
TELEGRAM_SYNC_BACKOFF_INITIAL_MS=5000
TELEGRAM_SYNC_BACKOFF_MAX_MS=300000
# Fail-closed acknowledgement for sync daemon/once. Leave empty until the old
# telegram-parilka-sync and every other owner of this MTProto session are
# stopped. Then set exactly lowercase `true`; units do not set it for you.
BOT_MTPROTO_EXCLUSIVE_OWNER=

# MCP send queue/outbox throttling.
TELEGRAM_GLOBAL_CONCURRENCY=2
TELEGRAM_MAX_RUNNING_PER_CHAT=1
TELEGRAM_USER_COOLDOWN_MS=20000
TELEGRAM_MAX_PENDING_PER_USER_PER_CHAT=1
TELEGRAM_MAX_QUEUE_PER_CHAT=25
TELEGRAM_QUEUE_MAX_AGE_MS=120000

# Retrieval embeddings. Recommended production path is the operator-owned
# loopback BGE-M3 service (backend local_bge_m3): one local encode yields the
# dense vector and the learned sparse terms, and cached text never leaves the
# machine. The external OpenAI-compatible backend below is kept only as a
# backward-compatible disabled option. A first-run index estimate still
# requires explicit confirmation for either backend.
TELEGRAM_EMBEDDINGS_ENABLED=false
# external_openai (default, legacy) or local_bge_m3 (recommended).
TELEGRAM_EMBEDDINGS_BACKEND=local_bge_m3
# Loopback origin of the local BGE-M3 service (see services/bge-m3). Required
# for local_bge_m3; must be a loopback HTTP(S) URL without credentials, query
# parameters, or fragments. No API key is used for the local backend.
TELEGRAM_EMBEDDINGS_LOCAL_ENDPOINT=http://127.0.0.1:8767
# Optional bounded ColBERT late-interaction rerank over the first-stage top-K.
# 0 disables it; hard ceiling is 32. Candidate text is scored locally and no
# vectors are persisted.
TELEGRAM_EMBEDDINGS_RERANK_MAX_CANDIDATES=0
TELEGRAM_EMBEDDINGS_RERANK_TIMEOUT_MS=10000
TELEGRAM_EMBEDDINGS_LOCAL_REQUEST_TIMEOUT_MS=30000
# The external backend below is only used when TELEGRAM_EMBEDDINGS_BACKEND is
# external_openai. Enabling it sends cached Telegram text to
# TELEGRAM_EMBEDDINGS_BASE_URL.
TELEGRAM_EMBEDDINGS_API_KEY=
# OPENAI_API_KEY is accepted as a fallback when the dedicated key above is empty.
OPENAI_API_KEY=
# HTTPS is required except for an operator-configured loopback HTTP endpoint.
# Credentials, query parameters, fragments, and HTTP redirects are rejected.
TELEGRAM_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# Ignored for local_bge_m3 (pinned to bge-m3 / 1024).
TELEGRAM_EMBEDDINGS_MODEL=text-embedding-3-small
TELEGRAM_EMBEDDINGS_DIMENSIONS=256
TELEGRAM_EMBEDDINGS_API_BATCH_SIZE=64
TELEGRAM_EMBEDDINGS_REQUEST_TIMEOUT_MS=60000
TELEGRAM_EMBEDDINGS_MAX_RETRIES=2
TELEGRAM_EMBEDDINGS_RETRY_INITIAL_MS=1000
TELEGRAM_EMBEDDINGS_RETRY_MAX_MS=30000
# Daemon indexing runs on its own cadence and cannot hold the Telegram
# history loop beyond this per-run deadline.
TELEGRAM_EMBEDDINGS_TICK_INTERVAL_MS=60000
TELEGRAM_EMBEDDINGS_TICK_BUDGET_MS=30000
TELEGRAM_EMBEDDINGS_CHUNK_MESSAGES=12
TELEGRAM_EMBEDDINGS_CHUNK_OVERLAP_MESSAGES=0
TELEGRAM_EMBEDDINGS_CHUNK_MAX_CHARS=1600
TELEGRAM_EMBEDDINGS_TICK_CHUNK_LIMIT=100
TELEGRAM_EMBEDDINGS_MAX_CHUNKS_PER_RUN=1000
TELEGRAM_EMBEDDINGS_MAX_CHARS_PER_RUN=500000
TELEGRAM_EMBEDDINGS_VECTOR_CANDIDATE_LIMIT=20000
TELEGRAM_EMBEDDINGS_SEARCH_LIMIT=12

# Durable Bot API poller. Shadow is the no-send default but still consumes
# updates: never run two long pollers with the same BOT_TOKEN.
BOT_TOKEN=
# Optional deployment indirection used by the supplied wrapper. When set, the
# owned 0400/0600 one-line file is loaded into BOT_TOKEN in memory and
# the secret does not need to be copied into this dotenv file.
# BOT_TOKEN_FILE=~/.bot-agi/token
# Fail-closed operator acknowledgement. Leave this empty until every other
# getUpdates poller for this token has been stopped. Then set exactly lowercase
# `true`; missing, empty, `TRUE`, and every other value are rejected in both
# shadow and live modes.
BOT_EXCLUSIVE_POLLER=
# Telegram user id of the application bot. Required whenever --apply runs with
# a model config, because that always runs the Dream pass; dry-run digest does
# not need it.
BOT_ID=100000000
BOT_USERNAME=ExampleBot
BOT_MODE=shadow
# Comma-separated immutable Telegram user IDs allowed to request fast-memory,
# lesson or skill writes. Leave blank to fail closed; keep the real allowlist
# only in the private runtime env, never in this repository or model config.
BOT_MEMORY_WRITE_SENDER_IDS=

# Must be the same file as TELEGRAM_DB_PATH. It can be omitted; this explicit
# value documents the invariant.
BOT_DB_PATH=~/.telegram-parilka-mcp/messages.sqlite

# Must be replaced with an absolute path to an existing JSON file.
BOT_MODEL_CONFIG_PATH=/absolute/path/to/your-checkout/config/model-router.json

# Optional private HH research gateway. The bot knows only this owner-only
# runtime socket, never the research repository path, corpus files or database.
# Set an already-resolved absolute runtime path (for example
# /run/user/<UID>/hh-research-gateway/gateway.sock); `%t` is a systemd-unit
# specifier, not dotenv syntax. Leave empty to disable `research_lookup`.
BOT_RESEARCH_GATEWAY_SOCKET=
BOT_RESEARCH_GATEWAY_TIMEOUT_MS=20000

# Machine-local SearXNG JSON API for the `searxng_search` model tool. This is a
# credential-free loopback HTTP origin; the bot never passes credentials,
# cookies or private state to it.
BOT_SEARXNG_ENDPOINT=http://127.0.0.1:8080

# Machine-local Firecrawl v2 API for the `firecrawl_crawl` model tool. This is
# a credential-free loopback HTTP origin. Only public HTTPS targets are ever
# sent to it, with external links, subdomains and sitemaps disabled.
BOT_FIRECRAWL_ENDPOINT=http://127.0.0.1:3002

# Runware image-generation backend for the `generate_image` model tool.
# Off by default -- both BOT_IMAGE_GENERATION_ENABLED=true and a non-empty
# RUNWARE_API_KEY are required to register the tool at all.
BOT_IMAGE_GENERATION_ENABLED=false
RUNWARE_API_KEY=
# BOT_IMAGE_GENERATION_ENDPOINT=https://api.runware.ai/v1
# BOT_IMAGE_GENERATION_TIMEOUT_MS=60000
#
# NSFW is a separate, deliberate operator decision, off by default. The live
# bot speaks Telegram Bot API (not an MTProto user session) -- Telegram
# moderates bot-sent adult content far more strictly than a user account, so
# enabling this risks the bot token being banned. Only set to true if you
# have accepted that risk.
BOT_IMAGE_GENERATION_NSFW_ALLOWED=false
# Conservative cost caps; raise later purely via env, no code change needed.
BOT_IMAGE_GENERATION_MAX_PER_TURN=1
BOT_IMAGE_GENERATION_MAX_PER_CHAT_PER_DAY=20
#
# The `edit_image` model tool (image-to-image on the reply/attached photo)
# reuses this same client, budget and RUNWARE_API_KEY -- no separate config.

# Runware text-to-speech backend for the `speak_text` model tool. Off by
# default -- both BOT_VOICE_REPLY_ENABLED=true and a non-empty
# RUNWARE_API_KEY (same key as image generation above) are required to
# register the tool at all.
BOT_VOICE_REPLY_ENABLED=false
# BOT_VOICE_REPLY_ENDPOINT=https://api.runware.ai/v1
# BOT_VOICE_REPLY_TIMEOUT_MS=60000
BOT_VOICE_REPLY_MAX_PER_TURN=1
BOT_VOICE_REPLY_MAX_PER_CHAT_PER_DAY=20

# Machine-local Flov speech-to-text for addressed voice messages, video notes
# and audio files. This is a loopback-only HTTP origin; the bot sends
# `postprocess=false`, so Flov never forwards the transcript to OpenRouter.
# Its timeout must leave the configured publishing timeout plus 10 seconds
# within the full bot-turn deadline.
BOT_AUDIO_TRANSCRIBE_ENDPOINT=http://127.0.0.1:17432
BOT_AUDIO_TRANSCRIBE_TIMEOUT_MS=300000
# Optional secret for a locally configured Flov API key. It is sent only as
# Authorization: Bearer to the validated loopback endpoint and never exposed
# by config inspection or logs.
BOT_AUDIO_TRANSCRIBE_BEARER_TOKEN=

# These names are referenced by config/model-router.example.json. The router
# reads secrets from env; never put API keys in the JSON file.
BOT_OPENAI_API_KEY=
BOT_ANTHROPIC_API_KEY=
# The supplied bot/digest wrappers can populate provider env variables from
# existing owned 0400/0600 one-line files. The shipped production router uses
# only BOT_DEEPSEEK_API_KEY; the Qwen key file is for a custom
# non-production router.
# BOT_QWEN_API_KEY_FILE=~/.bot-agi/dashscope_key
# BOT_DEEPSEEK_API_KEY_FILE=~/.bot-agi/deepseek_key

# Prompt metadata and bounded worker/polling settings.
BOT_DISPLAY_NAME=Example Assistant
# Required, no built-in default: this base ships persona-agnostic. Points to
# an absolute path to a JSON file listing every bot this deployment runs --
# both role: "assistant" (1-5 chats served by this process, Фаза 7 native
# multi-chat) and, optionally, a single role: "human-persona" entry (ADR
# 0005/0007) -- see config/bots.example.json. bot-agi-bot reads the
# assistant entries; bot-agi-sync reads the human-persona entry, if any.
# Each assistant entry's personaPromptPath and the shared
# config/persona.example.md point to a standalone markdown persona
# document, read at startup -- not inlined here, so multi-paragraph persona
# prose never needs .env escaping.
BOT_BOTS_CONFIG_PATH=/absolute/path/to/your-checkout/config/bots.json
BOT_HISTORY_DESCRIPTION=available local chat history
BOT_WORKERS=3
BOT_TRIGGER_COOLDOWN_MS=5000
BOT_UPDATE_MAX_ATTEMPTS=3
# Optional one-time migration fence: set to the legacy bot's persisted next
# update offset after the old poller is quiesced. It prevents redelivery of the
# final already-processed legacy batch while preserving all newer updates.
# BOT_INITIAL_OFFSET=0
BOT_POLL_TIMEOUT_SEC=30
BOT_POLL_LIMIT=100
BOT_POLL_BACKOFF_INITIAL_MS=1000
BOT_POLL_BACKOFF_MAX_MS=30000
# Per-provider model step only; there is no whole-turn deadline or fixed
# model/tool-step count ceiling.
BOT_MODEL_STEP_TIMEOUT_MS=180000
BOT_PUBLISH_TIMEOUT_MS=30000
BOT_SHUTDOWN_TIMEOUT_MS=660000

# Persistent curated chat memory and offline dream consolidation. Dream runs
# inside every bot-agi-digests apply pass. On a chat's first run it bootstraps
# exactly the seven completed Moscow calendar days ending yesterday and
# processes them oldest-first; later runs add missing days up to yesterday and
# retry failed/running days. Each day consolidates only real bot-reply
# interactions plus their neighboring context. BOT_MEMORY_MAX_CHARS is the
# hard budget for the injected memory block. The removed keys
# BOT_DREAM_EVERY_N_MESSAGES and BOT_DREAM_MAX_MESSAGES are ignored
# when left behind in older env files.
BOT_MEMORY_MAX_CHARS=2000

# Day/ISO-week digest generation. The dedicated values are optional: the CLI
# falls back to BOT_* and then the single Telegram chat/shared DB.
# Apply mode requires a model-router path; the systemd maintenance unit uses
# the bot router path above unless this override is set.
# BOT_DIGEST_CHAT_ID=-1000000000000
# BOT_DIGEST_DB_PATH=~/.telegram-parilka-mcp/messages.sqlite
# BOT_DIGEST_MODEL_CONFIG_PATH=/absolute/path/to/your-checkout/config/model-router.json
# Scheduled apply processes newest due periods first. Bounds: day 0-31,
# week 0-8. Zero keeps that phase generation-free during apply.
BOT_DIGEST_MAX_DAY_GENERATIONS_PER_RUN=3
BOT_DIGEST_MAX_WEEK_GENERATIONS_PER_RUN=1
BOT_DIGEST_MAX_INPUT_CHARS=160000
BOT_DIGEST_MAX_OUTPUT_CHARS=24000
BOT_DIGEST_ITEM_TIMEOUT_MS=150000
# Model deadlines shared by day/week digest summaries and the Dream pass of the
# same apply run. When unset, each phase falls back to its internal default
# (digest summaries 120 s total / 45 s per candidate; Dream 300 s / 60 s).
BOT_DIGEST_MODEL_TOTAL_TIMEOUT_MS=300000
# Must be less than or equal to BOT_DIGEST_MODEL_TOTAL_TIMEOUT_MS.
BOT_DIGEST_MODEL_CANDIDATE_TIMEOUT_MS=120000

# Human-persona style-profile pipeline (bin/bot-agi-human-persona-style, plan
# Фаза 4f/5 Шаг 2). All four values are required in apply mode; there is no
# default consent basis on purpose (plan 4a) — an unset
# BOT_HUMAN_PERSONA_CONSENT_BASIS or one that is neither confirmed_by_owner
# nor self makes the CLI refuse to run instead of silently skipping consent.
# Uncomment and set for the single MVP persona/chat/target this pipeline
# targets before wiring its ExecStart line into bot-agi-maintain.service.
# BOT_HUMAN_PERSONA_ID=example-persona
# BOT_HUMAN_PERSONA_CHAT_ID=-1000000000000
# BOT_HUMAN_PERSONA_TARGET_USER=123456789
# BOT_HUMAN_PERSONA_CONSENT_BASIS=confirmed_by_owner

# Human-persona trigger-engine + approval workflow (ADR 0005/0007), read
# from the same BOT_BOTS_CONFIG_PATH file above via its single optional
# role: "human-persona" entry -- bot-agi-sync reads it for the trigger/send
# runners, bot-agi-bot reads its approvalChatId for the approval poster.
# The whole role stays off (no-op every sync tick, no poster) unless that
# entry is present. See config/bots.example.json for the full field list
# (personaId, chatId, chatTitle, targetUserKey, approvalChatId,
# autonomyMode, activeHourStart/End, minSilenceMs,
# maxInitiationsPerWindow, windowMs -- all but the first five are optional
# and default the same as before). autonomyMode defaults to "approval" on
# purpose (plan 4c: start supervised, opt into "auto" only once you trust
# the persona's proposals). approvalChatId must be a separate Telegram
# chat from every assistant chat in the same file -- config validation
# rejects a collision at startup. Only there can bot-agi-bot post
# inline-keyboard buttons and capture "reply to correct the text" edits;
# it never joins the assistant role's own turn/fold pipeline.

# Hermes profile projection (systemd bot-agi-hermes-project.service). Apply
# pass writes managed memory/skills into the installed Hermes profile
# (~/.hermes/profiles/parilka) from the committed Dream state. This is the
# kill switch: enable it only after the profile is installed and the operator
# ran `hermes -p parilka gateway install --no-start-now`. Missing/empty/false
# skips the pass before any DB or profile access. Non-secret.
BOT_HERMES_PROJECTION_ENABLED=false

# Optional web search. BOT_WEB_SEARCH_PROVIDER selects the backend:
#   auto   - HTTP adapter if BOT_WEB_SEARCH_ENDPOINT is set, otherwise
#            Vertex if BOT_VERTEX_PROJECT is set, otherwise disabled.
#   http   - generic provider-neutral HTTP JSON adapter (requires endpoint).
#   vertex - bot-owned native Vertex Gemini grounding via gcloud ADC.
# Empty endpoint + no vertex project keeps web search disabled.
BOT_WEB_SEARCH_PROVIDER=auto
# HTTP adapter: endpoint receives POST {"query":"..."} and returns
# {"text":"...", "sources":[{"url":"https://...", "title":"..."}]}.
# Must be HTTPS, or loopback HTTP, without credentials/query/fragment.
# If a bearer token is needed, set the second variable to the NAME of a secret
# environment variable, then populate that variable separately.
BOT_WEB_SEARCH_ENDPOINT=
BOT_WEB_SEARCH_BEARER_TOKEN_ENV=
# BOT_WEB_SEARCH_TOKEN=
# Vertex adapter: Gemini is a search proxy (googleSearch grounding), not the
# answering model. Auth reuses Application Default Credentials via gcloud, so
# there is no API key here. Leave BOT_GCLOUD_PATH empty to resolve gcloud
# from PATH and standard locations.
# BOT_VERTEX_PROJECT=project-2eb13fe3-79a9-4d2b-83c
# BOT_VERTEX_WEB_SEARCH_MODEL=gemini-3.6-flash
# BOT_VERTEX_WEB_SEARCH_REGION=global
# BOT_VERTEX_WEB_SEARCH_MAX_OUTPUT_TOKENS=2000
# BOT_GCLOUD_PATH=
