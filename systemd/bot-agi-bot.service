[Unit]
Description=Bot Agi durable Telegram bot
Documentation=file:%h/projects/bot_agi/README.md
After=network-online.target bot-agi-sync.service
Wants=network-online.target bot-agi-sync.service
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/projects/bot_agi
EnvironmentFile=-%h/.config/telegram-mcp/.env
EnvironmentFile=-%h/.config/bot-agi/bot-agi.env
Environment=NODE_ENV=production
Environment=TELEGRAM_PROJECT_DIR=%h/projects/bot_agi
ExecStartPre=%h/projects/bot_agi/bin/telegram-bot-agi-mcp-check-build %h/projects/bot_agi %h/projects/bot_agi/dist/bot-daemon.js
ExecStart=%h/projects/bot_agi/bin/bot-agi-bot
Restart=on-failure
RestartSec=10s
# Runtime drain is configurable up to 15 minutes. Give systemd one extra
# minute so a graceful stop is not converted into SIGKILL at the boundary.
TimeoutStopSec=16min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.telegram-parilka-mcp
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bot-agi-bot

[Install]
WantedBy=default.target
