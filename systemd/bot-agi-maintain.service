[Unit]
Description=Bot Agi bounded SQLite maintenance and digest generation
Documentation=file:%h/projects/bot_agi/README.md
Documentation=file:%h/projects/bot_agi/src/maintenance/README.md
After=bot-agi-sync.service bot-agi-bot.service
# Weak dependency: the Hermes projection oneshot runs after this unit finishes,
# even when maintenance itself failed (e.g. a partial digest failure). A failed
# projection must never fail maintenance, hence Wants, not Requires.
Wants=bot-agi-hermes-project.service

[Service]
Type=oneshot
WorkingDirectory=%h/projects/bot_agi
EnvironmentFile=-%h/.config/telegram-mcp/.env
EnvironmentFile=-%h/.config/bot-agi/bot-agi.env
Environment=NODE_ENV=production
Environment=TELEGRAM_PROJECT_DIR=%h/projects/bot_agi
ExecStart=%h/projects/bot_agi/bin/bot-agi-maintain --apply
ExecStart=%h/projects/bot_agi/bin/bot-agi-digests --apply --summary-only
TimeoutStartSec=45min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.telegram-parilka-mcp
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bot-agi-maintain
