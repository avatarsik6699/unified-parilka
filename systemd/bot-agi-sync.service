[Unit]
Description=Bot Agi MTProto sync owner and loopback MCP
Documentation=file:%h/projects/bot_agi/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/projects/bot_agi
EnvironmentFile=-%h/.config/telegram-mcp/.env
EnvironmentFile=-%h/.config/bot-agi/bot-agi.env
Environment=NODE_ENV=production
Environment=TELEGRAM_PROJECT_DIR=%h/projects/bot_agi
ExecStartPre=%h/projects/bot_agi/bin/telegram-bot-agi-mcp-check-build %h/projects/bot_agi %h/projects/bot_agi/dist/sync-daemon.js
ExecStart=%h/projects/bot_agi/bin/telegram-bot-agi-mcp-sync-daemon
Restart=on-failure
RestartSec=10s
TimeoutStopSec=3min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.telegram-parilka-mcp
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bot-agi-sync

[Install]
WantedBy=default.target
