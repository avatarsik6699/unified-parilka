[Unit]
Description=Parilka bounded SQLite maintenance and digest generation
Documentation=file:%h/repos/parilka-unified/README.md
Documentation=file:%h/repos/parilka-unified/src/maintenance/README.md
After=parilka-sync.service parilka-bot.service

[Service]
Type=oneshot
WorkingDirectory=%h/repos/parilka-unified
EnvironmentFile=-%h/.config/telegram-mcp/.env
EnvironmentFile=-%h/.config/parilka/parilka.env
Environment=NODE_ENV=production
Environment=TELEGRAM_PROJECT_DIR=%h/repos/parilka-unified
ExecStart=%h/repos/parilka-unified/bin/parilka-maintain --apply
ExecStart=%h/repos/parilka-unified/bin/parilka-digests --apply --summary-only
TimeoutStartSec=45min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.telegram-parilka-mcp
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
SyslogIdentifier=parilka-maintain
