#!/usr/bin/env bash

# Source-only helper. It intentionally never prints a credential or its path.
bot_agi_load_secret_file() {
  local target_name="${1:?target variable name is required}"
  local path_name="${2:?path variable name is required}"
  local secret_path="${!path_name:-}"
  local secret_value
  local -a secret_lines=()

  if [[ -z "$secret_path" ]]; then
    return 0
  fi
  if [[ ! -f "$secret_path" || ! -r "$secret_path" || ! -O "$secret_path" ]]; then
    printf 'bot-agi: configured credential file is not a readable, owned regular file\n' >&2
    return 78
  fi
  case "$(stat -c '%a' -- "$secret_path")" in
    400|600) ;;
    *)
      printf 'bot-agi: configured credential file must have mode 0400 or 0600\n' >&2
      return 78
      ;;
  esac
  mapfile -t secret_lines < "$secret_path"
  if [[ "${#secret_lines[@]}" -ne 1 || -z "${secret_lines[0]}" || "${secret_lines[0]}" == *$'\r'* ]]; then
    printf 'bot-agi: configured credential file is empty or not one line\n' >&2
    return 78
  fi
  secret_value="${secret_lines[0]}"
  printf -v "$target_name" '%s' "$secret_value"
  export "$target_name"
  unset secret_value secret_lines
}
